{
  // Cloudflare-Einstellungen für lichtweite.photos
  "name": "fotografie-homepage",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "lichtweite.photos", "custom_domain": true },
    { "pattern": "www.lichtweite.photos", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lichtweite-likes",
      // HIER die Database ID aus dem Cloudflare-Dashboard einfügen:
      "database_id": "HIER-DATABASE-ID-EINFUEGEN"
    }
  ]
}
